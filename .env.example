# Copy this file to .env and fill in real values. .env is gitignored.

# Flask secret key — generate a strong random value; never commit the real one.
SECRET_KEY=replace-with-a-strong-random-secret

# Application environment: development | staging | production
APP_ENV=development

# Version string surfaced by the API responses.
APP_VERSION=1.0.0

# Host port the container is published on (maps to container port 5000).
HOST_PORT=5000
